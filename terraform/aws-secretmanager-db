# 1. Generate a secure, random password for the database
resource "random_password" "db_password" {
  length           = 16
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

# 2. Create the secret container inside AWS Secrets Manager
resource "aws_secretsmanager_secret" "itva_db_secret" {
  name        = "kriva/${var.environment}/itva-db-credentials"
  description = "Database credentials for the itva application"
  tags        = var.project_tags
}

# 3. Store the username and the generated password as a JSON object
resource "aws_secretsmanager_secret_version" "itva_db_secret_val" {
  secret_id     = aws_secretsmanager_secret.itva_db_secret.id
  secret_string = jsonencode({
    username = "db_admin"
    password = random_password.db_password.result
  })
}
